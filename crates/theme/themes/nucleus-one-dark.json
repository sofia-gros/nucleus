{
  "name": "Nucleus One Dark",
  "mode": "dark",
  "fonts": {
    "ui": "Inter",
    "mono": "JetBrains Mono",
    "mono_size": 13
  },
  "colors": {
    "background": "#282c34",
    "foreground": "#abb2bf",
    "border": "#181a1f",
    "muted.background": "#2c313a",
    "muted.foreground": "#7f848e",
    "accent.background": "#2c313a",
    "accent.foreground": "#d7dae0",
    "primary.background": "#568af2",
    "primary.foreground": "#ffffff",
    "primary.hover.background": "#6b99f4",
    "primary.active.background": "#4c7fe6",
    "secondary.background": "#333842",
    "secondary.foreground": "#d7dae0",
    "secondary.hover.background": "#3a404b",
    "secondary.active.background": "#2c313a",
    "input.border": "#181a1f",
    "ring": "#568af2",
    "caret": "#528bff",
    "selection.background": "#3e4451",
    "link": "#61afef",
    "overlay": "#00000066",
    "window.border": "#181a1f",
    "drag.border": "$primary.background",
    "drop_target.background": "$primary.background/15%",
    "skeleton.background": "#2c313a",
    "switch.background": "#3a404b",
    "danger.background": "#e06c75",
    "danger.foreground": "#ffffff",
    "success.background": "#98c379",
    "success.foreground": "#282c34",
    "warning.background": "#e5c07b",
    "warning.foreground": "#282c34",
    "info.background": "#56b6c2",
    "info.foreground": "#282c34",
    "popover.background": "#21252b",
    "popover.foreground": "#abb2bf",
    "list.background": "#21252b",
    "list.hover.background": "#2c313a",
    "list.active.background": "#3a3f4b",
    "list.active.border": "#568af2",
    "list.even.background": "$muted.background/40%",
    "list.head.background": "$muted.background",
    "list.highlight.foreground": "#61afef",
    "sidebar.background": "#21252b",
    "sidebar.foreground": "#9da5b4",
    "sidebar.border": "#181a1f",
    "sidebar.accent.background": "#2c313a",
    "sidebar.accent.foreground": "#d7dae0",
    "sidebar.primary.background": "$primary.background",
    "sidebar.primary.foreground": "$primary.foreground",
    "tab_bar.background": "#21252b",
    "tab.background": "#00000000",
    "tab.foreground": "#7f848e",
    "tab.active.background": "#282c34",
    "tab.active.foreground": "#d7dae0",
    "title_bar.background": "#21252b",
    "title_bar.border": "#181a1f",
    "status_bar.background": "#21252b",
    "status_bar.border": "#181a1f",
    "scrollbar.background": "#00000000",
    "scrollbar.thumb.background": "#4e566699",
    "scrollbar.thumb.hover.background": "#5c6370",
    "highlight.editor.background": "$background",
    "highlight.editor.foreground": "$foreground",
    "highlight.editor.active_line.background": "#2c313a",
    "highlight.editor.line_number": "#495162",
    "highlight.editor.active_line_number": "#abb2bf",
    "highlight.editor.invisible": "#3b4048",
    "highlight.created": "#98c379",
    "highlight.modified": "#e5c07b",
    "highlight.deleted": "#e06c75",
    "highlight.created.background": "$highlight.created/14%",
    "highlight.deleted.background": "$highlight.deleted/14%",
    "highlight.error": "#e06c75",
    "highlight.error.background": "$highlight.error/15%",
    "highlight.warning": "#e5c07b",
    "highlight.warning.background": "$highlight.warning/15%",
    "highlight.info": "#61afef",
    "highlight.hint": "#7f848e",
    "highlight.syntax.keyword": "#c678dd",
    "highlight.syntax.function": "#61afef",
    "highlight.syntax.string": "#98c379",
    "highlight.syntax.string.escape": "#56b6c2",
    "highlight.syntax.number": "#d19a66",
    "highlight.syntax.boolean": "#d19a66",
    "highlight.syntax.type": "#e5c07b",
    "highlight.syntax.constructor": "#e5c07b",
    "highlight.syntax.comment": "#5c6370",
    "highlight.syntax.comment.doc": "#5c6370",
    "highlight.syntax.variable": "$highlight.editor.foreground",
    "highlight.syntax.variable.special": "#c678dd",
    "highlight.syntax.property": "#e06c75",
    "highlight.syntax.constant": "#d19a66",
    "highlight.syntax.attribute": "#d19a66",
    "highlight.syntax.operator": "#56b6c2",
    "highlight.syntax.punctuation": "#abb2bf",
    "highlight.syntax.tag": "#e06c75",
    "highlight.syntax.label": "#e06c75",
    "highlight.syntax.preproc": "#56b6c2",
    "terminal.background": "$background",
    "terminal.foreground": "$foreground",
    "terminal.cursor": "$caret",
    "terminal.ansi.black": "#3f4451",
    "terminal.ansi.red": "#e06c75",
    "terminal.ansi.green": "#98c379",
    "terminal.ansi.yellow": "#e5c07b",
    "terminal.ansi.blue": "#61afef",
    "terminal.ansi.magenta": "#c678dd",
    "terminal.ansi.cyan": "#56b6c2",
    "terminal.ansi.white": "#d7dae0",
    "terminal.ansi.bright_black": "#4f5666",
    "terminal.ansi.bright_red": "#ff7b86",
    "terminal.ansi.bright_green": "#b1e18b",
    "terminal.ansi.bright_yellow": "#efca84",
    "terminal.ansi.bright_blue": "#67cdff",
    "terminal.ansi.bright_magenta": "#e48bff",
    "terminal.ansi.bright_cyan": "#63f2f1",
    "terminal.ansi.bright_white": "#ffffff"
  }
}
