{
  "name": "Nucleus One Light",
  "mode": "light",
  "fonts": {
    "ui": "Inter",
    "mono": "JetBrains Mono",
    "mono_size": 13
  },
  "colors": {
    "background": "#fafafa",
    "foreground": "#383a42",
    "border": "#dbdbdc",
    "muted.background": "#f0f0f1",
    "muted.foreground": "#8e8f96",
    "accent.background": "#e5e5e6",
    "accent.foreground": "#232324",
    "primary.background": "#526fff",
    "primary.foreground": "#ffffff",
    "primary.hover.background": "#6b84ff",
    "primary.active.background": "#4a63e6",
    "secondary.background": "#e5e5e6",
    "secondary.foreground": "#383a42",
    "secondary.hover.background": "#dbdbdc",
    "secondary.active.background": "#d0d0d1",
    "input.border": "#c8c8c9",
    "ring": "#526fff",
    "caret": "#526fff",
    "selection.background": "#e5e5e6",
    "link": "#4078f2",
    "overlay": "#00000026",
    "window.border": "#dbdbdc",
    "drag.border": "$primary.background",
    "drop_target.background": "$primary.background/12%",
    "skeleton.background": "#e5e5e6",
    "switch.background": "#d0d0d1",
    "danger.background": "#e45649",
    "danger.foreground": "#ffffff",
    "success.background": "#50a14f",
    "success.foreground": "#ffffff",
    "warning.background": "#c18401",
    "warning.foreground": "#ffffff",
    "info.background": "#0184bc",
    "info.foreground": "#ffffff",
    "popover.background": "#ffffff",
    "popover.foreground": "#383a42",
    "list.background": "#f5f5f6",
    "list.hover.background": "#e8e8e9",
    "list.active.background": "#dbdbdc",
    "list.active.border": "#526fff",
    "list.even.background": "$muted.background/60%",
    "list.head.background": "$muted.background",
    "list.highlight.foreground": "#4078f2",
    "sidebar.background": "#eaeaeb",
    "sidebar.foreground": "#383a42",
    "sidebar.border": "#dbdbdc",
    "sidebar.accent.background": "#dbdbdc",
    "sidebar.accent.foreground": "#232324",
    "sidebar.primary.background": "$primary.background",
    "sidebar.primary.foreground": "$primary.foreground",
    "tab_bar.background": "#eaeaeb",
    "tab.background": "#00000000",
    "tab.foreground": "#8e8f96",
    "tab.active.background": "#fafafa",
    "tab.active.foreground": "#232324",
    "title_bar.background": "#eaeaeb",
    "title_bar.border": "#dbdbdc",
    "status_bar.background": "#eaeaeb",
    "status_bar.border": "#dbdbdc",
    "scrollbar.background": "#00000000",
    "scrollbar.thumb.background": "#4f525e4d",
    "scrollbar.thumb.hover.background": "#4f525e80",
    "highlight.editor.background": "$background",
    "highlight.editor.foreground": "$foreground",
    "highlight.editor.active_line.background": "#f0f0f1",
    "highlight.editor.line_number": "#9d9d9f",
    "highlight.editor.active_line_number": "#383a42",
    "highlight.editor.invisible": "#d3d3d4",
    "highlight.created": "#50a14f",
    "highlight.modified": "#c18401",
    "highlight.deleted": "#e45649",
    "highlight.created.background": "$highlight.created/14%",
    "highlight.deleted.background": "$highlight.deleted/14%",
    "highlight.error": "#e45649",
    "highlight.error.background": "$highlight.error/12%",
    "highlight.warning": "#c18401",
    "highlight.warning.background": "$highlight.warning/12%",
    "highlight.info": "#4078f2",
    "highlight.hint": "#8e8f96",
    "highlight.syntax.keyword": "#a626a4",
    "highlight.syntax.function": "#4078f2",
    "highlight.syntax.string": "#50a14f",
    "highlight.syntax.string.escape": "#0184bc",
    "highlight.syntax.number": "#986801",
    "highlight.syntax.boolean": "#986801",
    "highlight.syntax.type": "#c18401",
    "highlight.syntax.constructor": "#c18401",
    "highlight.syntax.comment": "#a0a1a7",
    "highlight.syntax.comment.doc": "#a0a1a7",
    "highlight.syntax.variable": "$highlight.editor.foreground",
    "highlight.syntax.variable.special": "#a626a4",
    "highlight.syntax.property": "#e45649",
    "highlight.syntax.constant": "#986801",
    "highlight.syntax.attribute": "#986801",
    "highlight.syntax.operator": "#0184bc",
    "highlight.syntax.punctuation": "#383a42",
    "highlight.syntax.tag": "#e45649",
    "highlight.syntax.label": "#e45649",
    "highlight.syntax.preproc": "#0184bc",
    "terminal.background": "$background",
    "terminal.foreground": "$foreground",
    "terminal.cursor": "$caret",
    "terminal.ansi.black": "#383a42",
    "terminal.ansi.red": "#e45649",
    "terminal.ansi.green": "#50a14f",
    "terminal.ansi.yellow": "#c18401",
    "terminal.ansi.blue": "#4078f2",
    "terminal.ansi.magenta": "#a626a4",
    "terminal.ansi.cyan": "#0184bc",
    "terminal.ansi.white": "#a0a1a7",
    "terminal.ansi.bright_black": "#4f525e",
    "terminal.ansi.bright_red": "#e06c75",
    "terminal.ansi.bright_green": "#98c379",
    "terminal.ansi.bright_yellow": "#d8a13b",
    "terminal.ansi.bright_blue": "#61afef",
    "terminal.ansi.bright_magenta": "#c678dd",
    "terminal.ansi.bright_cyan": "#56b6c2",
    "terminal.ansi.bright_white": "#ffffff"
  }
}
